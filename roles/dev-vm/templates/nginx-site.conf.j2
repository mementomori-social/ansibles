# Managed by mementomori-social/ansibles (dev-vm role). Forwards
# {{ dev_vm_domain }} to the Docker dev stack's Caddy on port {{ dev_vm_port }}.
server {
    listen 443 ssl;
    server_name {{ dev_vm_domain }};

    ssl_certificate {{ dev_vm_checkout }}/dev/certs/{{ dev_vm_domain }}.pem;
    ssl_certificate_key {{ dev_vm_checkout }}/dev/certs/{{ dev_vm_domain }}-key.pem;

    client_max_body_size 100m;

    location / {
        proxy_pass https://127.0.0.1:{{ dev_vm_port }};
        proxy_ssl_server_name on;
        proxy_ssl_name {{ dev_vm_domain }};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        # Vite's live-reload socket lives under /packs-dev
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $http_connection;
        proxy_buffering off;
        proxy_read_timeout 300s;
    }

    # Live timelines and notifications
    location /api/v1/streaming {
        proxy_pass https://127.0.0.1:{{ dev_vm_port }};
        proxy_ssl_server_name on;
        proxy_ssl_name {{ dev_vm_domain }};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_buffering off;
        proxy_read_timeout 1d;
    }
}

server {
    listen 80;
    server_name {{ dev_vm_domain }};
    return 301 https://$host$request_uri;
}
