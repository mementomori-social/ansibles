proxy_cache_path   /tmp/nginx-cache-instance-media levels=1:2 keys_zone=s3_cache:10m max_size=10g
                    inactive=48h use_temp_path=off;

server {
    listen 80;
    listen [::]:80;
    server_name media.mementomori.social;

    access_log off;
    error_log off;

    root {{ nginx_mementomori_mastodon_home }}/live/public/system;

    set $s3_backend 'https://6165bc9eb7d1b4d09a6b22251dfd7741.r2.cloudflarestorage.com';

    keepalive_timeout 30;

    location = / {
        index index.html;
    }

    location / {
        try_files $uri @s3;
    }
    
    location @s3 {
        limit_except GET {
          deny all;
        }

        resolver 9.9.9.9;
        proxy_set_header Host '6165bc9eb7d1b4d09a6b22251dfd7741.r2.cloudflarestorage.com';
        proxy_set_header Connection '';
        proxy_set_header Authorization '';
        proxy_hide_header Set-Cookie;
        proxy_hide_header 'Access-Control-Allow-Origin';
        proxy_hide_header 'Access-Control-Allow-Methods';
        proxy_hide_header 'Access-Control-Allow-Headers';
        proxy_hide_header x-amz-id-2;
        proxy_hide_header x-amz-request-id;
        proxy_hide_header x-amz-meta-server-side-encryption;
        proxy_hide_header x-amz-server-side-encryption;
        proxy_hide_header x-amz-bucket-region;
        proxy_hide_header x-amzn-requestid;
        proxy_ignore_headers Set-Cookie;
        proxy_pass $s3_backend$uri;
        proxy_intercept_errors off;

        proxy_cache s3_cache;
        proxy_cache_valid 200 304 48h;
        proxy_cache_use_stale error timeout updating http_500 http_502 http_503 http_504;
        proxy_cache_lock on;
        proxy_cache_revalidate on;

        expires 1y;
        add_header Cache-Control public;
        add_header 'Access-Control-Allow-Origin' '*';
        add_header X-Cache-Status $upstream_cache_status;
    }
}

server {
    listen 80;
    server_name www.mementomori.social;
    root {{ nginx_mementomori_mastodon_home }}/live/public;

    location /.well-known/acme-challenge/ { allow all; }

    location / {
      if ($host != $primary_domain) {
        rewrite ^(.*)$ $scheme://$primary_domain permanent;
      }
    }
}

server {
    listen 443 ssl http2;

    root {{ nginx_mementomori_mastodon_home }}/live/public;

    server_name www.mementomori.social;

    set $primary_domain "mementomori.social";

    ssl_certificate /etc/letsencrypt/live/mementomori.social/fullchain.pem;
