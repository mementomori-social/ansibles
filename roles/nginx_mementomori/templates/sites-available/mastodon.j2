map $http_upgrade $connection_upgrade {
  default upgrade;
  ''      close;
}


upstream backend {
    server 127.0.0.1:3000 fail_timeout=0;
}

upstream streaming {
    server 127.0.0.1:4000 fail_timeout=0;
    server 127.0.0.1:4001 fail_timeout=0;
    server 127.0.0.1:4002 fail_timeout=0;
    server 127.0.0.1:4003 fail_timeout=0;
}

proxy_cache_path /var/cache/nginx levels=1:2 keys_zone=CACHE:10m inactive=7d max_size=1g;

map $sent_http_content_type $expires {
    "text/html"                 epoch;
    "text/html; charset=utf-8"  epoch;
    default                     off;
}

server {
  listen 443 ssl http2;
  server_name mementomori.social;

{% if nginx_mementomori_bot_blocker_enabled %}

  ##
  # Nginx Bad Bot Blocker Includes
  # REPO: https://github.com/mitchellkrogza/nginx-ultimate-bad-bot-blocker
  ##
  include /etc/nginx/bots.d/ddos.conf;
  include /etc/nginx/bots.d/blockbots.conf;

{% endif %}
 
  location /.well-known/acme-challenge/ { allow all; }

  location ^~ /suomalaiset-mastodon-kayttajat {
    alias {{ nginx_mementomori_mastodon_home }}/suomalaiset-mastodon-kayttajat/;
    index index.html;

    # Block sensitive files
    location ~* /(fetch\.php|\.env|composer\.|package\.|yarn\.lock|vendor/) {
      deny all;
      return 404;
    }

    location ~ \.php$ {      
      try_files $uri {{ nginx_mementomori_mastodon_home }}/suomalaiset-mastodon-kayttajat/auth.php;

      fastcgi_split_path_info ^(.+\.php)(/.+)$;
      include fastcgi_params;
      fastcgi_read_timeout 300;
      fastcgi_buffer_size 128k;
      fastcgi_buffers 8 128k;
      fastcgi_busy_buffers_size 128k;
      fastcgi_temp_file_write_size 128k;

      fastcgi_index auth.php;
      fastcgi_param SCRIPT_FILENAME $request_filename;

      fastcgi_pass 127.0.0.1:9074;
      #fastcgi_pass unix:/run/php/php8.1-fpm.sock;
    }
  }

  location ^~ /the-mastodon-list {
    alias {{ nginx_mementomori_mastodon_home }}/the-mastodon-list/;
    index index.html;
  }

  ssl_protocols TLSv1.2 TLSv1.3;
  ssl_ciphers HIGH:!MEDIUM:!LOW:!aNULL:!NULL:!SHA;
  ssl_prefer_server_ciphers on;
  ssl_session_cache shared:SSL:10m;
  ssl_session_tickets off;

  # Uncomment these lines once you acquire a certificate:
  ssl_certificate     /etc/letsencrypt/live/mementomori.social/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/mementomori.social/privkey.pem;

  keepalive_timeout    70;
  sendfile             on;
  client_max_body_size 99m;

  # https://mementomori.social/@cadusilva@bolha.one/112150337662652715
  #proxy_request_buffering off;
  #client_max_body_size 0;

  # 2024-03-23 19:36:32.857
  # "proxy_buffer_size 4096 is not enough for cache key, it should be increased to at least 5120"
  # And: cache file "/var/cache/nginx/e/a6/65af96022f3e6107245ea17387feaa6e" has too long header
  # https://bavatuesdays.com/some-initial-mastodon-instance-tweaking/
  # https://www.cyberciti.biz/faq/nginx-upstream-sent-too-big-header-while-reading-response-header-from-upstream/      
  # https://github.com/doorkeeper-gem/doorkeeper/issues/1554#issuecomment-1304606633
  proxy_buffers 4 128k;
  proxy_buffer_size 128k;
  proxy_busy_buffers_size 128k;

  root {{ nginx_mementomori_mastodon_home }}/live/public;

  gzip on;
  gzip_disable "msie6";
  gzip_vary on;
  gzip_proxied any;
  gzip_comp_level 6;
  gzip_buffers 16 8k;
  gzip_http_version 1.1;
  gzip_types text/plain text/css application/json application/javascript text/xml application/xml application/xml+rss text/javascript image/svg+xml image/x-icon;

  # CORS
  add_header 'Access-Control-Allow-Origin' '*';
  add_header 'Access-Control-Allow-Headers' 'Authorization,Accept,Origin,DNT,X-CustomHeader,Keep-Alive,User-Agent,X-Requested-With,If-Modified-Since,Cache-Control,Content-Type,Content-Range,Range';
  add_header 'Access-Control-Allow-Methods' 'GET,POST,OPTIONS,PUT,DELETE,PATCH';

  location / {
    try_files $uri @proxy;

    # CORS
    add_header 'Access-Control-Allow-Origin' '*';
    add_header 'Access-Control-Allow-Headers' 'Authorization,Accept,Origin,DNT,X-CustomHeader,Keep-Alive,User-Agent,X-Requested-With,If-Modified-Since,Cache-Control,Content-Type,Content-Range,Range';
    add_header 'Access-Control-Allow-Methods' 'GET,POST,OPTIONS,PUT,DELETE,PATCH';
  }

  # If Docker is used for deployment and Rails serves static files,
  # then needed must replace line `try_files $uri =404;` with `try_files $uri @proxy;`.
  location = sw.js {
    # Served from disk, never reaches puma. Declaring a limit_req here replaces
    # the inherited `flood` zone from bots.d/ddos.conf, which would otherwise
    # 503 the cold asset burst that follows every upgrade (content hashes
    # change, so nothing is left in browser cache).
    limit_req zone=staticassets burst=2000 nodelay;
    add_header Cache-Control "public, max-age=604800, must-revalidate";
    add_header Strict-Transport-Security "max-age=63072000; includeSubDomains";
    try_files $uri =404;
  }

  location ~ ^/assets/ {
    # Served from disk, never reaches puma. Declaring a limit_req here replaces
    # the inherited `flood` zone from bots.d/ddos.conf, which would otherwise
    # 503 the cold asset burst that follows every upgrade (content hashes
    # change, so nothing is left in browser cache).
    limit_req zone=staticassets burst=2000 nodelay;
    add_header Cache-Control "public, max-age=2419200, must-revalidate";
    add_header Strict-Transport-Security "max-age=63072000; includeSubDomains";
    try_files $uri =404;
  }

  location ~ ^/avatars/ {
    # Served from disk, never reaches puma. Declaring a limit_req here replaces
    # the inherited `flood` zone from bots.d/ddos.conf, which would otherwise
    # 503 the cold asset burst that follows every upgrade (content hashes
    # change, so nothing is left in browser cache).
    limit_req zone=staticassets burst=2000 nodelay;
    add_header Cache-Control "public, max-age=2419200, must-revalidate";
    add_header Strict-Transport-Security "max-age=63072000; includeSubDomains";

    # CORS
    add_header 'Access-Control-Allow-Origin' '*';
    add_header 'Access-Control-Allow-Headers' 'Authorization,Accept,Origin,DNT,X-CustomHeader,Keep-Alive,User-Agent,X-Requested-With,If-Modified-Since,Cache-Control,Content-Type,Content-Range,Range';
    add_header 'Access-Control-Allow-Methods' 'GET,POST,OPTIONS,PUT,DELETE,PATCH';

    try_files $uri =404;
  }

  location ~ ^/emoji/ {
    # Served from disk, never reaches puma. Declaring a limit_req here replaces
    # the inherited `flood` zone from bots.d/ddos.conf, which would otherwise
    # 503 the cold asset burst that follows every upgrade (content hashes
    # change, so nothing is left in browser cache).
    limit_req zone=staticassets burst=2000 nodelay;
    add_header Cache-Control "public, max-age=2419200, must-revalidate";
    add_header Strict-Transport-Security "max-age=63072000; includeSubDomains";

    # CORS
    add_header 'Access-Control-Allow-Origin' '*';
    add_header 'Access-Control-Allow-Headers' 'Authorization,Accept,Origin,DNT,X-CustomHeader,Keep-Alive,User-Agent,X-Requested-With,If-Modified-Since,Cache-Control,Content-Type,Content-Range,Range';
    add_header 'Access-Control-Allow-Methods' 'GET,POST,OPTIONS,PUT,DELETE,PATCH';

    try_files $uri =404;
  }

  location ~ ^/headers/ {
    # Served from disk, never reaches puma. Declaring a limit_req here replaces
    # the inherited `flood` zone from bots.d/ddos.conf, which would otherwise
    # 503 the cold asset burst that follows every upgrade (content hashes
    # change, so nothing is left in browser cache).
    limit_req zone=staticassets burst=2000 nodelay;
    add_header Cache-Control "public, max-age=2419200, must-revalidate";
    add_header Strict-Transport-Security "max-age=63072000; includeSubDomains";
    try_files $uri =404;
  }

  location ~ ^/packs/ {
    # Served from disk, never reaches puma. Declaring a limit_req here replaces
    # the inherited `flood` zone from bots.d/ddos.conf, which would otherwise
    # 503 the cold asset burst that follows every upgrade (content hashes
    # change, so nothing is left in browser cache).
    limit_req zone=staticassets burst=2000 nodelay;
    add_header Cache-Control "public, max-age=2419200, must-revalidate";
    add_header Strict-Transport-Security "max-age=63072000; includeSubDomains";
  
    # CORS
    add_header 'Access-Control-Allow-Origin' '*';
    add_header 'Access-Control-Allow-Headers' 'Authorization,Accept,Origin,DNT,X-CustomHeader,Keep-Alive,User-Agent,X-Requested-With,If-Modified-Since,Cache-Control,Content-Type,Content-Range,Range';
    add_header 'Access-Control-Allow-Methods' 'GET,POST,OPTIONS,PUT,DELETE,PATCH';

    try_files $uri =404;
  }

  location ~ ^/shortcuts/ {
    # Served from disk, never reaches puma. Declaring a limit_req here replaces
    # the inherited `flood` zone from bots.d/ddos.conf, which would otherwise
    # 503 the cold asset burst that follows every upgrade (content hashes
    # change, so nothing is left in browser cache).
    limit_req zone=staticassets burst=2000 nodelay;
    add_header Cache-Control "public, max-age=2419200, must-revalidate";
    add_header Strict-Transport-Security "max-age=63072000; includeSubDomains";
    try_files $uri =404;
  }

  location ~ ^/sounds/ {
    # Served from disk, never reaches puma. Declaring a limit_req here replaces
    # the inherited `flood` zone from bots.d/ddos.conf, which would otherwise
    # 503 the cold asset burst that follows every upgrade (content hashes
    # change, so nothing is left in browser cache).
    limit_req zone=staticassets burst=2000 nodelay;
    add_header Cache-Control "public, max-age=2419200, must-revalidate";
    add_header Strict-Transport-Security "max-age=63072000; includeSubDomains";
    try_files $uri =404;
  }

  location ~ ^/system/ {
    # Served from disk, never reaches puma. Declaring a limit_req here replaces
    # the inherited `flood` zone from bots.d/ddos.conf, which would otherwise
    # 503 the cold asset burst that follows every upgrade (content hashes
    # change, so nothing is left in browser cache).
    limit_req zone=staticassets burst=2000 nodelay;
    add_header Cache-Control "public, max-age=2419200, immutable";
    add_header Strict-Transport-Security "max-age=63072000; includeSubDomains";
    try_files $uri =404;
  }

  location ^~ /api/v1/streaming/ {
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Proxy "";

    proxy_pass http://streaming;
    proxy_buffering off;
    proxy_redirect off;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;

    add_header Strict-Transport-Security "max-age=63072000; includeSubDomains";

    tcp_nodelay on;
  }

  location @proxy {
    # Mastodon never uses HTTP Basic Auth (OAuth Bearer + HTTP Signatures only),
    # so a Basic header is always bogus. Scrapers send them, and because several
    # API endpoints answer with `Vary: Authorization`, each distinct value became
    # its own nginx cache entry and defeated caching. Reject here: no upstream cost.
    if ($http_authorization ~* "^Basic") {
      return 401;
    }

    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Proxy "";
    proxy_pass_header Server;

    proxy_pass http://backend;
    proxy_buffering on;
    proxy_read_timeout 120s;

    # https://mementomori.social/@cadusilva@bolha.one/112150337662652715
    #proxy_buffering off;
    #proxy_request_buffering off;
    #client_max_body_size 0;

    # 2024-03-23 19:36:32.857
    # "proxy_buffer_size 4096 is not enough for cache key, it should be increased to at least 5120"
    # And: cache file "/var/cache/nginx/e/a6/65af96022f3e6107245ea17387feaa6e" has too long header
    # https://bavatuesdays.com/some-initial-mastodon-instance-tweaking/
    # https://www.cyberciti.biz/faq/nginx-upstream-sent-too-big-header-while-reading-response-header-from-upstream/      
    # https://github.com/doorkeeper-gem/doorkeeper/issues/1554#issuecomment-1304606633
    proxy_buffers 4 128k;
    proxy_buffer_size 128k;
    proxy_busy_buffers_size 128k;

    proxy_redirect off;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;

    proxy_cache CACHE;
    proxy_cache_valid 200 7d;
    proxy_cache_valid 410 24h;
    proxy_cache_use_stale error timeout updating http_500 http_502 http_503 http_504;
    add_header X-Cached $upstream_cache_status;

    tcp_nodelay on;
  }

  error_page 404 500 501 502 503 504 /500.html;
}


