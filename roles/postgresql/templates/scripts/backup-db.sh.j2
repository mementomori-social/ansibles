#!/bin/bash

# Variables
# Check if required mount exists
if ! mountpoint -q {{ postgresql_backupdir }}; then
    echo "Error: Backup drive is not mounted at {{ postgresql_backupdir }}"
    exit 1
fi

# Directory to clean up
backup_dir="{{ postgresql_backupdir }}/"

# Clean up old backups while maintaining disk space under X%
cleanup_old_backups() {
    local threshold={{ postgresql_backup_diskspace_threshold }}
    local usage=$(df -h "$backup_dir" | awk 'NR==2 {print $5}' | cut -d'%' -f1)
    local avail_kb=$(df -k --output=avail "$backup_dir" | tail -1 | tr -d ' ')

    # The next dump needs room too: keep free space above the newest dump plus 10%
    local newest_backup=$(find "$backup_dir" -maxdepth 1 -type d -name "mastodon_production_*.backup" -printf '%T+ %p\n' | sort | tail -1 | cut -d' ' -f2-)
    local needed_kb=0
    if [ -n "$newest_backup" ]; then
        needed_kb=$(( $(du -sk "$newest_backup" | cut -f1) * 11 / 10 ))
    fi

    echo "Starting cleanup. Current disk usage: ${usage}%, free: $((avail_kb / 1048576))G, next dump needs: $((needed_kb / 1048576))G"

    while [ "$usage" -gt "$threshold" ] || [ "$avail_kb" -lt "$needed_kb" ]; do
        # Never delete the last backup
        if [ "$(find "$backup_dir" -maxdepth 1 -type d -name "mastodon_production_*.backup" | wc -l)" -le 1 ]; then
            echo "Only one backup left, not deleting it"
            break
        fi

        # Find and delete the oldest backup directory
        oldest_backup=$(find "$backup_dir" -maxdepth 1 -type d -name "mastodon_production_*.backup" -printf '%T+ %p\n' | sort | head -1 | cut -d' ' -f2-)

        echo "Removing old backup: $(basename "$oldest_backup")"
        rm -rf "$oldest_backup"

        # Recalculate usage after deletion
        usage=$(df -h "$backup_dir" | awk 'NR==2 {print $5}' | cut -d'%' -f1)
        avail_kb=$(df -k --output=avail "$backup_dir" | tail -1 | tr -d ' ')
        echo "Current disk usage after deletion: ${usage}%, free: $((avail_kb / 1048576))G"
    done

    echo "Cleanup complete. Current disk usage: ${usage}%, free: $((avail_kb / 1048576))G"

    # Return failure if there is still not enough room
    [ "$usage" -le "$threshold" ] && [ "$avail_kb" -ge "$needed_kb" ]
}

# Run cleanup
if ! cleanup_old_backups; then
    echo "Warning: Error while cleaning up old backups"
fi

# Check disk space usage
check_disk_space() {
    local mount_point=$1
    local threshold={{ postgresql_backup_diskspace_threshold }}
    local usage=$(df -h "$mount_point" | awk 'NR==2 {print $5}' | cut -d'%' -f1)

    if [ "$usage" -gt "$threshold" ]; then
        echo "Error: $mount_point is ${usage}% full (threshold: ${threshold}%)"
        return 1
    fi
    return 0
}

# Check storage space on mount point
if ! check_disk_space "{{ postgresql_backupdir }}"; then
    echo "Please free up space on backup drive before running backup"
    exit 1
fi

# Backup to directory format
echo "Creating directory format backup with parallel jobs..."
if ! ionice -c2 -n7 nice -n19 pg_dump --host={{ postgresql_host }} --username mastodon --port {{ postgresql_port }} --dbname mastodon_production --verbose --jobs=2 --compress=5 --format=directory --file="{{ postgresql_backupdir }}/mastodon_production_$(date +\%Y\-%m\-%d\_%H-%M).backup"; then
    echo "Error: Directory format backup failed"
    exit 1
fi

echo "Backup complete."

# Send a heartbeat on success
echo "Sending heartbeat..."
curl https://uptime.betterstack.com/api/v1/heartbeat/{{ postgresql_backup_betterstack_heartbeat }}
echo "Heartbeat sent."
