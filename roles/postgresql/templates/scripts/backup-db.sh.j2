#!/bin/bash

# Variables
# Check if required mount exists
if ! mountpoint -q {{ postgresql_backupdir }}; then
    echo "Error: Backup drive is not mounted at {{ postgresql_backupdir }}"
    exit 1
fi

# Directory to clean up
backup_dir="{{ postgresql_backupdir }}/"

# Clean up old backups while maintaining disk space under X%
cleanup_old_backups() {
    local threshold={{ postgresql_backup_diskspace_threshold }}
    local usage=$(df -h "$backup_dir" | awk 'NR==2 {print $5}' | cut -d'%' -f1)

    echo "Starting cleanup. Current disk usage: ${usage}%"

    while [ "$usage" -gt "$threshold" ]; do
        # Find and delete the oldest backup directory
        oldest_backup=$(find "$backup_dir" -maxdepth 1 -type d -name "mastodon_production_*.backup" -printf '%T+ %p\n' | sort | head -1 | cut -d' ' -f2-)

        if [ -z "$oldest_backup" ]; then
            echo "No more backups to clean up"
            break
        fi

        echo "Removing old backup: $(basename "$oldest_backup")"
        rm -rf "$oldest_backup"

        # Recalculate usage after deletion
        usage=$(df -h "$backup_dir" | awk 'NR==2 {print $5}' | cut -d'%' -f1)
        echo "Current disk usage after deletion: ${usage}%"
    done

    echo "Cleanup complete. Current disk usage: ${usage}%"

    # Return failure if we couldn't get under threshold
    [ "$usage" -le "$threshold" ]
}

# Run cleanup
if ! cleanup_old_backups; then
    echo "Warning: Error while cleaning up old backups"
fi

# Check disk space usage
check_disk_space() {
    local mount_point=$1
    local threshold={{ postgresql_backup_diskspace_threshold }}
    local usage=$(df -h "$mount_point" | awk 'NR==2 {print $5}' | cut -d'%' -f1)

    if [ "$usage" -gt "$threshold" ]; then
        echo "Error: $mount_point is ${usage}% full (threshold: ${threshold}%)"
        return 1
    fi
    return 0
}

# Check storage space on mount point
if ! check_disk_space "{{ postgresql_backupdir }}"; then
    echo "Please free up space on backup drive before running backup"
    exit 1
fi

# Backup to directory format
echo "Creating directory format backup with parallel jobs..."
if ! sudo ionice -c2 -n7 nice -n19 pg_dump --host={{ postgresql_host }} --username mastodon --port {{ postgresql_port }} --dbname mastodon_production --verbose --jobs=2 --compress=5 --format=directory --file="{{ postgresql_backupdir }}/mastodon_production_$(date +\%Y\-%m\-%d\_%H-%M).backup"; then
    echo "Error: Directory format backup failed"
    exit 1
fi

echo "Backup complete."

# Send a heartbeat on success
echo "Sending heartbeat..."
curl https://uptime.betterstack.com/api/v1/heartbeat/{{ postgresql_backup_betterstack_heartbeat }}
echo "Heartbeat sent."
