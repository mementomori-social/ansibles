[Unit]
Description=Refresh the Finnish users list account cache
After=network.target

[Service]
Type=oneshot
User=mastodon
WorkingDirectory={{ mastodon_home }}/suomalaiset-mastodon-kayttajat
ExecStart=/usr/bin/php {{ mastodon_home }}/suomalaiset-mastodon-kayttajat/fetch.php
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
