#!/bin/bash
# Exits on first failure and logs, so a broken run is visible instead of silent.
# rbenv shims must come first: cron has no login PATH, and bin/tootctl uses
# /usr/bin/env ruby, which otherwise finds the system Ruby and fails at bundler.
set -euo pipefail

export PATH="{{ mastodon_home }}/.rbenv/shims:{{ mastodon_home }}/.rbenv/bin:$PATH"
export RAILS_ENV=production

LOG={{ mastodon_home }}/logs/build-search-index.log
exec >>"$LOG" 2>&1
echo "--- $(date -Is) starting, ruby $(ruby --version | cut -d' ' -f2) ---"

cd {{ mastodon_home }}/live

# https://github.com/VyrCossont/mastodon/pull/8
bundle exec bin/tootctl search deploy --concurrency 16 --batch_size 4096

echo "--- $(date -Is) done ---"
